# Reference for explicit host/debug or custom deployments, not default startup.
# Default: make docker-up; private config is .agent-kernel/docker-local/config.env.
AGENT_KERNEL_ENV=development
AGENT_KERNEL_LOG_LEVEL=info

# DATABASE_URL is required; only PostgreSQL with psycopg is supported.
# This example is for a custom host/debug deployment. Default Docker config
# uses postgres:5432 internally and does not publish a host database port.
DATABASE_URL=postgresql+psycopg://agent_kernel:agent_kernel@localhost:5432/agent_kernel
REDIS_URL=redis://localhost:6379/0
# Object storage. local is the default; s3 supports AWS S3 and MinIO-compatible
# endpoints when the deployment provides boto3 and credentials.
AGENT_KERNEL_OBJECT_STORE_BACKEND=local
AGENT_KERNEL_OBJECT_STORE_ROOT=.agent-kernel/objects
AGENT_KERNEL_S3_BUCKET=
AGENT_KERNEL_S3_PREFIX=
AGENT_KERNEL_S3_ENDPOINT_URL=
AGENT_KERNEL_S3_REGION=

# Vector storage: auto/pgvector use the migrated native vector column;
# json explicitly selects JSON-vector similarity within PostgreSQL.
AGENT_KERNEL_VECTOR_STORE=auto

# OpenTelemetry tracing. Disabled by default. Enable in production images that
# include opentelemetry-sdk and opentelemetry-exporter-otlp-proto-http.
AGENT_KERNEL_OTEL_ENABLED=false
AGENT_KERNEL_OTEL_SERVICE_NAME=agent-kernel
AGENT_KERNEL_OTEL_EXPORTER=otlp-http
AGENT_KERNEL_OTEL_ENDPOINT=http://localhost:4318
AGENT_KERNEL_OTEL_TRACES_ENDPOINT=

# Beta authentication. Leave disabled for local mock quickstart flows.
AGENT_KERNEL_API_KEY_AUTH_ENABLED=false

# Post-v1.0 hardening. Redis is optional for queue hints, required for shared limits.
AGENT_KERNEL_RUN_QUEUE_BACKEND=database
AGENT_KERNEL_RUN_QUEUE_MAX_LENGTH=10000
AGENT_KERNEL_REDIS_TIMEOUT_SECONDS=1
AGENT_KERNEL_REDIS_CONNECT_TIMEOUT_SECONDS=1
AGENT_KERNEL_RATE_LIMIT_REQUESTS=0
AGENT_KERNEL_RATE_LIMIT_PRINCIPAL_REQUESTS=0
AGENT_KERNEL_RATE_LIMIT_API_KEY_REQUESTS=0
AGENT_KERNEL_EMBEDDING_PROVIDER=mock
AGENT_KERNEL_RATE_LIMIT_WINDOW_SECONDS=60
# Separate monitoring credential, not a workspace API key. Set a strong secret
# (at least 32 ASCII characters) before exposing any metrics listener.
AGENT_KERNEL_MONITORING_TOKEN=
AGENT_KERNEL_WORKER_METRICS_ENABLED=false
AGENT_KERNEL_WORKER_METRICS_HOST=127.0.0.1
AGENT_KERNEL_WORKER_METRICS_PORT=9001
# Trusted local JSON configuration only; never accept uploads as this file.
AGENT_KERNEL_EXTERNAL_TOOLS_CONFIG=

# API process binding.
AGENT_KERNEL_API_HOST=0.0.0.0
AGENT_KERNEL_API_PORT=8000

# Docker Compose host ports. Change these when another local stack is already
# using the defaults.
AGENT_KERNEL_WEB_PORT=3000
AGENT_KERNEL_POSTGRES_PORT=5432
AGENT_KERNEL_REDIS_PORT=6379

# Web runtime.
AGENT_KERNEL_API_URL=http://127.0.0.1:8000
# CLI-only credential. Never use a NEXT_PUBLIC_* variable for secrets.
AGENT_KERNEL_API_KEY=
NEXT_PUBLIC_AGENT_KERNEL_API_URL=http://127.0.0.1:8000

# Optional OpenAI provider credentials. Mock and replay providers do not require this.
OPENAI_API_KEY=

# Optional OpenAI embeddings backend configuration. Select it explicitly with
# AGENT_KERNEL_EMBEDDING_PROVIDER=openai on both API and Worker.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Explicit pilot providers; keys never fall back to OPENAI_API_KEY or each other.
# See docs/provider-compatibility.md. These values do not activate the local stack.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
# Configuration-only readiness: no model/balance/network requests.
# AGENT_KERNEL_READINESS_DEEPSEEK=required
# AGENT_KERNEL_READINESS_DASHSCOPE=required

# Trusted native execution bounds, shared by API/CLI/Worker (not run input).
AGENT_KERNEL_MAX_MODEL_CALLS=8
AGENT_KERNEL_MAX_TOOL_CALLS=16
AGENT_KERNEL_MAX_ACTIVE_SECONDS=300
AGENT_KERNEL_MAX_HISTORY_BYTES=1048576
AGENT_KERNEL_MAX_TOTAL_TOKENS=64000
AGENT_KERNEL_MAX_OUTPUT_TOKENS=4096
# Optional observed provider-reported cost ceiling; empty disables.
AGENT_KERNEL_MAX_ESTIMATED_COST=
