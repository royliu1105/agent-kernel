AGENT_KERNEL_ENV=development
AGENT_KERNEL_LOG_LEVEL=info

# Local Python runtime. Leave DATABASE_URL unset to use SQLite at
# .agent-kernel/agent_kernel.db, or use the Postgres URL below when Docker
# services are running.
DATABASE_URL=postgresql+psycopg://agent_kernel:agent_kernel@localhost:5432/agent_kernel
REDIS_URL=redis://localhost:6379/0
# Object storage. local is the default; s3 supports AWS S3 and MinIO-compatible
# endpoints when the deployment provides boto3 and credentials.
AGENT_KERNEL_OBJECT_STORE_BACKEND=local
AGENT_KERNEL_OBJECT_STORE_ROOT=.agent-kernel/objects
AGENT_KERNEL_S3_BUCKET=
AGENT_KERNEL_S3_PREFIX=
AGENT_KERNEL_S3_ENDPOINT_URL=
AGENT_KERNEL_S3_REGION=

# Vector storage mode: auto uses pgvector on PostgreSQL and JSON vectors on
# SQLite; json forces portable JSON-vector similarity; pgvector requires
# PostgreSQL with the vector extension migration applied.
AGENT_KERNEL_VECTOR_STORE=auto

# OpenTelemetry tracing. Disabled by default. Enable in production images that
# include opentelemetry-sdk and opentelemetry-exporter-otlp-proto-http.
AGENT_KERNEL_OTEL_ENABLED=false
AGENT_KERNEL_OTEL_SERVICE_NAME=agent-kernel
AGENT_KERNEL_OTEL_EXPORTER=otlp-http
AGENT_KERNEL_OTEL_ENDPOINT=http://localhost:4318
AGENT_KERNEL_OTEL_TRACES_ENDPOINT=

# Beta authentication. Leave disabled for local mock quickstart flows.
AGENT_KERNEL_API_KEY_AUTH_ENABLED=false

# API process binding.
AGENT_KERNEL_API_HOST=0.0.0.0
AGENT_KERNEL_API_PORT=8000

# Web runtime.
AGENT_KERNEL_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_AGENT_KERNEL_API_URL=http://127.0.0.1:8000

# Optional OpenAI provider credentials. Mock and replay providers do not require this.
OPENAI_API_KEY=

# Optional OpenAI embeddings backend configuration. Mock embeddings remain the
# default unless application code explicitly wires OpenAIEmbeddingProvider.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
