{
  "global": {"scrape_interval": "15s", "scrape_timeout": "5s", "evaluation_interval": "30s"},
  "rule_files": ["/etc/prometheus/alerts.json", "/etc/prometheus/telemetry-alerts.json"],
  "alerting": {"alertmanagers": [{"static_configs": [{"targets": ["alertmanager:9093"]}]}]},
  "scrape_configs": [
    {
      "job_name": "agent-kernel-api", "metrics_path": "/metrics",
      "authorization": {"type": "Bearer", "credentials_file": "/run/secrets/monitoring_token"},
      "static_configs": [{"targets": ["api:8000"]}]
    },
    {
      "job_name": "agent-kernel-worker", "metrics_path": "/metrics",
      "authorization": {"type": "Bearer", "credentials_file": "/run/secrets/monitoring_token"},
      "static_configs": [{"targets": ["worker:9001"]}]
    },
    {
      "job_name": "agent-kernel-readiness", "metrics_path": "/probe",
      "params": {"module": ["http_ready"]},
      "static_configs": [{"targets": ["http://api:8000/readyz"]}],
      "relabel_configs": [
        {"source_labels": ["__address__"], "target_label": "__param_target"},
        {"source_labels": ["__param_target"], "target_label": "instance"},
        {"target_label": "__address__", "replacement": "blackbox:9115"}
      ]
    },
    {
      "job_name": "agent-kernel-telemetry",
      "static_configs": [{"targets": ["alloy:12345", "loki:3100", "tempo:3200", "alertmanager:9093"]}]
    }
  ]
}
