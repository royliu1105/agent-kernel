{
  "id": null,
  "uid": "agent-kernel-operations",
  "title": "Agent Kernel Operations",
  "tags": [
    "agent-kernel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Target availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "agent-kernel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"agent-kernel-(api|worker)\"}",
          "legendFormat": "{{job}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "Required dependency readiness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "agent-kernel-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"agent-kernel-readiness\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
