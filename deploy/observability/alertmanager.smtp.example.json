{
  "global": {
    "resolve_timeout": "5m", "smtp_smarthost": "smtp.example.invalid:587",
    "smtp_from": "agent-kernel@example.invalid", "smtp_auth_username": "agent-kernel@example.invalid",
    "smtp_auth_password_file": "/run/secrets/smtp_password", "smtp_require_tls": true
  },
  "route": {
    "receiver": "operator-email", "group_by": ["alertname", "job"],
    "group_wait": "30s", "group_interval": "5m", "repeat_interval": "4h"
  },
  "receivers": [{"name": "operator-email", "email_configs": [{
    "to": "operator@example.invalid", "send_resolved": true,
    "headers": {"Subject": "[Agent Kernel {{ .Status | toUpper }}] {{ .CommonLabels.alertname }}"},
    "text": "{{ template \"agent_kernel.text\" . }}"
  }]}],
  "templates": ["/etc/alertmanager/email.tmpl"]
}
