      "alert_rule_test": [
        {
          "eval_time": "15m",
          "alertname": "AgentKernelRunFailures",
          "exp_alerts": []
        }
      ]
    },
    {
      "interval": "1m",
      "input_series": [
        {
          "series": "llm_estimated_cost_total{job=\"agent-kernel-worker\",model=\"mock\",provider=\"mock\"}",
