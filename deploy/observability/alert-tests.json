            {
              "exp_labels": {
                "severity": "warning",
                "job": "agent-kernel-api"
              },
              "exp_annotations": {
                "summary": "Terminal execution segment failure ratio exceeds 20 percent."
              }
            }
          ]
        },
        {
          "eval_time": "30m",
          "alertname": "AgentKernelRunFailures",
          "exp_alerts": []
        }
      ]
    },
    {
      "interval": "1m",
      "input_series": [
        {
          "series": "agent_run_segments_total{job=\"agent-kernel-api\",outcome=\"failed\"}",
