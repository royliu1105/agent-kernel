    {
      "interval": "1m",
      "input_series": [
        {
          "series": "up{job=\"agent-kernel-api\",instance=\"api:8000\"}",
          "values": "0+0x10"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "4m",
          "alertname": "AgentKernelTargetDown",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "critical",
                "job": "agent-kernel-api",
                "instance": "api:8000"
              },
              "exp_annotations": {
                "summary": "Agent Kernel metrics target is unreachable."
              }
            }
          ]
        }
      ]
    },
    {
      "interval": "1m",
      "input_series": [
