{
  "rule_files": ["telemetry-alerts.json"],
  "evaluation_interval": "1m",
  "tests": [
    {
      "interval": "1m",
      "input_series": [{"series": "up{job=\"agent-kernel-telemetry\",instance=\"tempo:3200\"}", "values": "0 0 0 1 1"}],
      "alert_rule_test": [
        {"eval_time": "1m", "alertname": "AgentKernelTelemetryTargetDown", "exp_alerts": []},
        {"eval_time": "2m", "alertname": "AgentKernelTelemetryTargetDown", "exp_alerts": [{
          "exp_labels": {"job": "agent-kernel-telemetry", "instance": "tempo:3200", "severity": "warning"},
          "exp_annotations": {"summary": "An observability backend or collector cannot be scraped."}
        }]},
        {"eval_time": "3m", "alertname": "AgentKernelTelemetryTargetDown", "exp_alerts": []}
      ]
    },
    {
      "interval": "1m",
      "input_series": [{"series": "alertmanager_notifications_failed_total{integration=\"email\"}", "values": "0 1 1 1 1 1 1 1 1"}],
      "alert_rule_test": [
        {"eval_time": "1m", "alertname": "AgentKernelEmailDeliveryFailure", "exp_alerts": []},
        {"eval_time": "2m", "alertname": "AgentKernelEmailDeliveryFailure", "exp_alerts": [{
          "exp_labels": {"severity": "warning"},
          "exp_annotations": {"summary": "SMTP delivery failed; inspect Alertmanager and the mailbox separately."}
        }]},
        {"eval_time": "8m", "alertname": "AgentKernelEmailDeliveryFailure", "exp_alerts": []}
      ]
    }
  ]
}
