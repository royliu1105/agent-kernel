FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

COPY pyproject.toml uv.lock alembic.ini README.md ./
COPY apps ./apps
COPY packages ./packages
COPY evals ./evals
COPY examples ./examples

ARG INSTALL_OBSERVABILITY=false
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$INSTALL_OBSERVABILITY" = "true" ]; then \
      uv sync --frozen --no-dev --extra observability; \
    else uv sync --frozen --no-dev; fi

CMD ["agent-kernel-api"]
